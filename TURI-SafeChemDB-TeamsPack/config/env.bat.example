@echo off
REM Copy to env.bat and adjust paths for your machine / Teams sync location.

set "PACK_ROOT=%~dp0.."
for %%I in ("%PACK_ROOT%") do set "PACK_ROOT=%%~fI"

set "PYTHONPATH=%PACK_ROOT%\app"
set "EXPERT_P2OASYS_CSV=%PACK_ROOT%\app\data\priority_expert_p2oasys_scores.csv"

REM Optional. Leave unset so the app's path boxes start empty.
REM set "HSPIP_PATH=C:\Program Files\Hansen-Solubility\HSPiP"
REM set "HSPIP_DATA=C:\path\to\sofx"
REM set "HSPIP_DATA_DIR=%HSPIP_DATA%"

REM GHaz7 P2OASys score lookup (expert + auto). Copy p2oasys_score_lookup.sqlite
REM into app\data\ or point at the sibling GHaz7 data file:
set "P2OASYS_SCORE_LOOKUP_DB=%PACK_ROOT%\app\data\p2oasys_score_lookup.sqlite"
if not exist "%P2OASYS_SCORE_LOOKUP_DB%" (
  set "P2OASYS_SCORE_LOOKUP_DB=%PACK_ROOT%\..\GHhaz6\GHaz7\quick-hazard-assessment-app\data\p2oasys_score_lookup.sqlite"
)

REM Fisher enrich default (1=on, 0=off):
set "DOSS_ENABLE_FISHER=1"
